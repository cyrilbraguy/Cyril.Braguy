\documentclass[11pt,a4paper]{extarticle}

\usepackage{fontspec}
\setmainfont{texgyreheros}[
  Extension = .otf,
  Path = fonts/,
  UprightFont = *-regular,
  BoldFont = *-bold,
  ItalicFont = *-italic,
  BoldItalicFont = *-bolditalic
]

\usepackage[margin=0pt]{geometry}
\usepackage{paracol}
\usepackage{xcolor}
\usepackage{titlesec}
\usepackage{enumitem}
\usepackage{hyperref}
\usepackage{graphicx}
\usepackage{parskip}
\usepackage{tikz}

\definecolor{accent}{HTML}{3E5282}
\definecolor{banner}{HTML}{2C3A60}
\definecolor{sidebarbg}{HTML}{EDEDED}
\definecolor{bodytext}{HTML}{262626}
\definecolor{graytext}{HTML}{595959}
\definecolor{rulegray}{HTML}{CCCCCC}

\pagestyle{empty}
\setlength{\columnsep}{0pt}
\setlength{\columnseprule}{0pt}
\setlength{\parindent}{0pt}
\color{bodytext}

% ---------- "+ Section Title" header, used in sidebar and main column ----------
\newcommand{\cvheader}[1]{%
  \par\vspace{0.5em}%
  \noindent{\color{white}\colorbox{accent}{\makebox[1.1em][c]{\footnotesize\bfseries +}}}%
  \hspace{0.4em}{\color{accent}\bfseries\MakeUppercase{#1}}\par
  \vspace{0.15em}{\color{rulegray}\hrule height 0.6pt}\vspace{0.45em}%
}

\titleformat{\subsection}{\relax}{}{0pt}{\relax}[]
\let\subsection\cvheader

\setlist[itemize]{leftmargin=1.05em, itemsep=1pt, topsep=2pt, parsep=0pt}

\hypersetup{colorlinks=true, urlcolor=accent, linkcolor=accent}

\providecommand{\tightlist}{\setlength{\itemsep}{0pt}\setlength{\parskip}{0pt}}

% ---------- experience entry: narrow date column + content column ----------
\newenvironment{cventry}[1]{%
  \par\noindent
  \begin{minipage}[t]{0.135\linewidth}\raggedleft\color{accent}\bfseries\footnotesize #1\end{minipage}%
  \hfill\begin{minipage}[t]{0.845\linewidth}\small
}{%
  \end{minipage}\par\vspace{0.5em}%
}

$if(header-includes)$
$for(header-includes)$
$header-includes$
$endfor$
$endif$

\begin{document}

% ================= TOP BANNER =================
\noindent
\begin{minipage}[c][2.6cm][c]{0.25\linewidth}
  \hspace{0.9cm}%
  \begin{minipage}{\dimexpr\linewidth-0.9cm}
  {\color{accent}\huge\bfseries $title$}\par\vspace{0.1em}
  {\large\color{bodytext} $subtitle$}\par
  {\color{graytext} $tagline$}\par
  \end{minipage}
\end{minipage}%
\colorbox{banner}{%
\begin{minipage}[c][2.6cm][c]{0.75\linewidth}
  \begin{minipage}{0.62\linewidth}
  \color{white}\small
  $if(sidebar-contact)$$sidebar-contact$$endif$
  \end{minipage}\hfill
  \begin{minipage}{0.3\linewidth}
  \centering
  $if(photo)$\includegraphics[width=2.1cm]{$photo$}$endif$
  \end{minipage}\hspace{0.4cm}
\end{minipage}%
}
\par\vspace{0.5em}

\columnratio{0.25}
\begin{paracol}{2}

% ================= SIDEBAR =================
\begin{leftcolumn}
\colorbox{sidebarbg}{%
\begin{minipage}[t]{\linewidth}
\vspace{0.6em}\hspace{0.75em}%
\begin{minipage}{\dimexpr\linewidth-1.4em}

$if(sidebar-training)$
\cvheader{Training}
{\small $sidebar-training$}
$endif$

$if(sidebar-education)$
\cvheader{Education}
{\small $sidebar-education$}
$endif$

$if(sidebar-qualities)$
\cvheader{Qualities}
\begingroup
\renewcommand{\labelitemi}{\textcolor{accent}{\rule{0.42em}{0.42em}}}
{\small $sidebar-qualities$}
\endgroup
$endif$

$if(sidebar-strongpoints)$
\cvheader{Strong Points}
{\small $sidebar-strongpoints$}
$endif$

$if(sidebar-hobbies)$
\cvheader{Hobbies}
{\small $sidebar-hobbies$}
$endif$

\end{minipage}
\vspace{0.6em}
\end{minipage}%
}
\end{leftcolumn}

\switchcolumn[1]
% ================= MAIN CONTENT =================
\begin{rightcolumn}
\hspace{1.1em}%
\begin{minipage}{\dimexpr\linewidth-2.2em}
$body$
\end{minipage}
\end{rightcolumn}

\end{paracol}
\end{document}
