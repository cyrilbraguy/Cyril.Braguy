\documentclass[11pt,a4paper]{extarticle}

\usepackage{fontspec}
\setmainfont{texgyreheros}[
  Extension = .otf,
  Path = fonts/,
  UprightFont = *-regular,
  BoldFont = *-bold,
  ItalicFont = *-italic,
  BoldItalicFont = *-bolditalic
]

\usepackage[margin=0.5cm]{geometry}
\usepackage{paracol}
\usepackage{xcolor}
\usepackage{titlesec}
\usepackage{enumitem}
\usepackage{hyperref}
\usepackage{graphicx}
\usepackage{parskip}
\usepackage{tikz}

\definecolor{accent}{HTML}{3E5282}
\definecolor{banner}{HTML}{2C3A60}
\definecolor{sidebarbg}{HTML}{EDEDED}
\definecolor{bodytext}{HTML}{262626}
\definecolor{graytext}{HTML}{595959}
\definecolor{rulegray}{HTML}{CCCCCC}

\pagestyle{empty}
\setlength{\columnsep}{0pt}
\setlength{\columnseprule}{0pt}
\setlength{\parindent}{0pt}
\color{bodytext}

% =========================================================================
% AERATION -- tune these lengths to fill the page (all in one place)
% AERATION -- sidebar (left column, tuned independently)
\newlength{\cvHeaderBeforeLeft} \setlength{\cvHeaderBeforeLeft}{0.5em}
\newlength{\cvHeaderRuleLeft}   \setlength{\cvHeaderRuleLeft}{4pt}
\newlength{\cvHeaderAfterLeft}  \setlength{\cvHeaderAfterLeft}{0.3em}
\newlength{\cvItemSepLeft}      \setlength{\cvItemSepLeft}{2pt}
\newlength{\cvTopSepLeft}       \setlength{\cvTopSepLeft}{3pt}
% =========================================================================
\newlength{\cvParSkip}        \setlength{\cvParSkip}{0pt}        % space between paragraphs (whole doc)
\newlength{\cvHeaderBefore}   \setlength{\cvHeaderBefore}{0.05em}  % space before a "+ TITLE" header
\newlength{\cvHeaderRule}     \setlength{\cvHeaderRule}{4pt}       % space between title and rule ← AJUSTER ICI
\newlength{\cvHeaderAfter}    \setlength{\cvHeaderAfter}{0pt}   % space after the header's rule
\newlength{\cvEntrySpace}     \setlength{\cvEntrySpace}{0pt}      % space between two experience entries
\newlength{\cvItemSep}        \setlength{\cvItemSep}{0pt}         % space between bullet points
\newlength{\cvTopSep}         \setlength{\cvTopSep}{1pt}          % space before the first bullet of a list
\newlength{\cvColumnTopPad}   \setlength{\cvColumnTopPad}{0.5em}  % space above "Training" / "Profile"
% =========================================================================

\setlength{\parskip}{\cvParSkip}

% Switch to sidebar spacing values
\newcommand{\sidebarspacing}{%
  \setlength{\cvHeaderBefore}{\cvHeaderBeforeLeft}%
  \setlength{\cvHeaderRule}{\cvHeaderRuleLeft}%
  \setlength{\cvHeaderAfter}{\cvHeaderAfterLeft}%
  \setlength{\cvItemSep}{\cvItemSepLeft}%
  \setlength{\cvTopSep}{\cvTopSepLeft}%
}

% ---------- "+ Section Title" header, used in sidebar and main column ----------
\newcommand{\cvheader}[1]{%
  \par\vspace{\cvHeaderBefore}%
  \noindent
  \raisebox{1.52pt}{\colorbox{accent}{\makebox[1.1em][c]{\color{white}\footnotesize\bfseries +}}}%
  \hspace{0.4em}{\color{accent}\bfseries\MakeUppercase{#1}}\par
  \vspace{-\baselineskip}\vspace{\cvHeaderRule}%
  \noindent{\color{rulegray}\rule[0pt]{\dimexpr\linewidth-\rightskip}{0.6pt}}\par
  \vspace{\cvHeaderAfter}%
}

\titleformat{\subsection}{\relax}{}{0pt}{\relax}[]
\let\subsection\cvheader

\setlist[itemize]{leftmargin=1.05em, itemsep=\cvItemSep, topsep=\cvTopSep, parsep=0pt}

\hypersetup{colorlinks=true, urlcolor=accent, linkcolor=accent}

\providecommand{\tightlist}{\setlength{\itemsep}{0pt}\setlength{\parskip}{0pt}}

% ---------- experience entry: narrow date column + content column ----------
\newenvironment{cventry}[1]{%
  \par\noindent
  \raisebox{8.4pt}{\begin{minipage}[t]{0.07\linewidth}\raggedleft\color{accent}\bfseries\small #1\end{minipage}}%
  \hspace{0.5em}\begin{minipage}[t]{0.88\linewidth}\small
}{%
  \end{minipage}\par\vspace{\cvEntrySpace}%
}

$if(header-includes)$
$for(header-includes)$
$header-includes$
$endfor$
$endif$

\begin{document}

% ================= TOP BANNER =================
\noindent
\begin{minipage}[c][2.6cm][c]{0.26\linewidth}
  \hspace{0.7em}%
  \begin{minipage}{\dimexpr\linewidth-0.7em-0.5em}
  {\color{accent}\huge\bfseries $title$}\par\vspace{0.1em}
  {\large\color{bodytext} $subtitle$}\par
  {\color{graytext} $tagline$}\par
  \end{minipage}
\end{minipage}%
\colorbox{banner}{%
\begin{minipage}[c][2.6cm][c]{0.74\linewidth}
  \begin{minipage}{0.62\linewidth}
  \hypersetup{urlcolor=white}
  \color{white}\small
  $if(sidebar-contact)$$sidebar-contact$$endif$
  \end{minipage}\hfill
  \begin{minipage}{0.3\linewidth}
  \centering
  $if(photo)$\includegraphics[width=2.1cm]{$photo$}$endif$
  \end{minipage}\hspace{0.4cm}
\end{minipage}%
}
\par
\columnratio{0.25}
\begin{paracol}{2}

% ================= SIDEBAR =================
\begin{leftcolumn}
\colorbox{sidebarbg}{%
\begin{minipage}[t][\dimexpr\textheight-2.6cm-1cm][t]{\linewidth}
{\leftskip=0.7em\rightskip=0.7em
\sidebarspacing%
\vspace{\cvColumnTopPad}%

$if(sidebar-training)$
\cvheader{Training}
{\small $sidebar-training$}
$endif$
\vspace{\stretch{1}}

$if(sidebar-education)$
\cvheader{Education}
{\small $sidebar-education$}
$endif$
\vspace{\stretch{1}}

$if(sidebar-qualities)$
\cvheader{Qualities}
\begingroup
\renewcommand{\labelitemi}{\textcolor{accent}{\rule{0.42em}{0.42em}}}
{\small $sidebar-qualities$}
\endgroup
$endif$
\vspace{\stretch{1}}

$if(sidebar-strongpoints)$
\cvheader{Strong Points}
{\small $sidebar-strongpoints$}
$endif$
\vspace{\stretch{1}}

$if(sidebar-hobbies)$
\cvheader{Hobbies}
{\small $sidebar-hobbies$}
$endif$
\par}
\vfill
\end{minipage}%
}
\end{leftcolumn}

\switchcolumn[1]
% ================= MAIN CONTENT =================
\begin{rightcolumn}
{\leftskip=1.1em\rightskip=1.1em
\vspace{\cvColumnTopPad}%
$body$
\par}
\end{rightcolumn}

\end{paracol}
\end{document}
